[Unit]
Description=Socket for isolated Source Mirror media validation

[Socket]
TriggerLimitIntervalSec=60
TriggerLimitBurst=6
ListenStream=/run/nailhub-source-mirror-media-validator.sock
SocketUser=nailhub-source-mirror-media
SocketGroup=nailhub-source-mirror
SocketMode=0660
Accept=yes
MaxConnections=2

[Install]
WantedBy=sockets.target
