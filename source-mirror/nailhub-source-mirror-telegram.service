[Unit]
Description=Independent Source Mirror Telegram bot
After=network-online.target

[Service]
Type=simple
User=nailhub-source-mirror-telegram
Group=nailhub-source-mirror-telegram
WorkingDirectory=/opt/nailhub-source-mirror
ExecStart=/opt/nailhub-source-mirror/.venv/bin/python -m source_mirror.telegram_bot
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nailhub-source-mirror-telegram
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
