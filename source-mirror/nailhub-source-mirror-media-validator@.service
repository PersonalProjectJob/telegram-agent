[Unit]
Description=Isolated Source Mirror media validation

[Service]
Type=exec
User=nailhub-source-mirror-media
Group=nailhub-source-mirror-media
EnvironmentFile=/etc/nailhub-source-mirror-media-validator/peer.env
ExecStart=/usr/bin/env -i SOURCE_MIRROR_MEDIA_ALLOWED_UID=${SOURCE_MIRROR_MEDIA_ALLOWED_UID} /usr/bin/python3 -I /opt/nailhub-source-mirror/source_mirror/isolated_media_validator.py
StandardInput=socket
StandardOutput=socket
StandardError=null
TimeoutStartSec=15
RuntimeMaxSec=15
MemoryMax=512M
TasksMax=4
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
InaccessiblePaths=-/var/lib/agentfleet -/var/lib/nailhub-source-mirror -/etc/nailhub -/etc/nailhub-source-mirror -/etc/nailhub-review-validator
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
